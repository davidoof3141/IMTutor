# Copy to .env and fill in.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Used for book-index retrieval (app/rag/embeddings.py). Requires the pgvector
# extension (see book_chunks table in app/store/db.py) sized to match --
# text-embedding-3-small is 1536 dimensions.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- CORS ---
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Plain psycopg URL. Use host `localhost` outside Docker; docker-compose sets
# host `db` for the containerised backend.
DATABASE_URL=postgresql://itm:itm@localhost:5432/itm_tutor

# --- Auth ---
# Secret used to sign login tokens (HS256). Use a long random string.
AUTH_SECRET=dev-only-secret-change-me-to-a-long-random-string
# Seeded on first startup only, as an approved admin, if the username is absent.
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=change-me
